generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Admin {
  id               Int       @id @default(autoincrement())
  username         String    @unique @db.VarChar(100)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  moderatedComments Comment[] @relation("ModeratedByAdmin")

  @@map("admins")
}

model Blog {
  id            Int         @id @default(autoincrement())
  slug          String      @unique @db.VarChar(191)
  title         String      @db.VarChar(255)
  excerpt       String      @db.VarChar(500)
  content       String      @db.Text
  coverImageUrl String      @map("cover_image_url") @db.VarChar(500)
  isPublished   Boolean     @default(false) @map("is_published")
  postedAt      DateTime?   @map("posted_at")
  viewCount     Int         @default(0) @map("view_count")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  images        BlogImage[]
  comments      Comment[]

  @@map("blogs")
}

model BlogImage {
  id        Int      @id @default(autoincrement())
  blogId    Int      @map("blog_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(1) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("blog_images")
}

model Comment {
  id                Int           @id @default(autoincrement())
  blogId             Int           @map("blog_id")
  authorName         String        @map("author_name") @db.VarChar(120)
  message            String        @db.VarChar(1000)
  status             CommentStatus @default(PENDING)
  createdAt          DateTime      @default(now()) @map("created_at")
  moderatedAt        DateTime?     @map("moderated_at")
  moderatedByAdminId Int?          @map("moderated_by_admin_id")
  blog               Blog          @relation(fields: [blogId], references: [id], onDelete: Cascade)
  moderatedByAdmin   Admin?        @relation("ModeratedByAdmin", fields: [moderatedByAdminId], references: [id], onDelete: SetNull)

  @@map("comments")
}
